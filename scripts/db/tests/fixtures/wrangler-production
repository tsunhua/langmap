#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
from pathlib import Path


DATABASE_NAME = "langmap-v2"
DATABASE_ID = "69a50b71-8cff-4e50-9e73-1e9020d34bd3"


def main(argv: list[str]) -> int:
    log_path = os.environ.get("FAKE_PRODUCTION_WRANGLER_LOG")
    if log_path:
        with Path(log_path).open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(argv, ensure_ascii=False) + "\n")
    if argv[:3] == ["d1", "info", DATABASE_NAME]:
        print(json.dumps({"database": {"name": DATABASE_NAME, "uuid": DATABASE_ID}}))
        return 0
    if argv[:4] == ["d1", "time-travel", "info", DATABASE_NAME]:
        print(json.dumps({"bookmark": "bookmark-123"}))
        return 0
    if argv[:4] == ["d1", "migrations", "apply", DATABASE_NAME]:
        if not os.environ.get("FAKE_PRODUCTION_ALLOW_MUTATIONS"):
            print("mutation reached fake production", file=sys.stderr)
            return 3
        print(json.dumps({"success": True}))
        return 0
    if argv[:4] == ["d1", "time-travel", "restore", DATABASE_NAME]:
        if not os.environ.get("FAKE_PRODUCTION_ALLOW_MUTATIONS"):
            print("mutation reached fake production", file=sys.stderr)
            return 3
        print(json.dumps({"previous_bookmark": "previous-bookmark-123"}))
        return 0
    if argv[:3] != ["d1", "execute", DATABASE_NAME] or "--command" not in argv:
        if argv[:3] == ["d1", "execute", DATABASE_NAME] and "--file" in argv and os.environ.get("FAKE_PRODUCTION_ALLOW_MUTATIONS"):
            print(json.dumps({"success": True}))
            return 0
        print("unsupported production fake command", file=sys.stderr)
        return 2
    sql = argv[argv.index("--command") + 1]
    lowered = sql.lower()
    if any(token in lowered for token in ("insert", "update", "delete", "drop", "alter", "replace")):
        print("mutation reached fake production", file=sys.stderr)
        return 3
    if "sqlite_master" in lowered:
        rows = [
            {"kind": "schema", "type": "table", "name": "languages", "sql": "CREATE TABLE languages"},
            {"kind": "schema", "type": "index", "name": "idx_languages_name", "sql": "CREATE INDEX idx_languages_name"},
            {"kind": "schema", "type": "trigger", "name": "expressions_ai", "sql": "CREATE TRIGGER expressions_ai"},
            {"kind": "column", "table_name": "languages", "name": "code", "column_type": "TEXT"},
            {"kind": "column", "table_name": "languages", "name": "name", "column_type": "TEXT"},
            {"kind": "migration", "name": "0001_initial_schema.sql"},
        ]
        print(json.dumps([{"results": rows}]))
        return 0
    if "pragma table_info" in lowered:
        print(json.dumps([
            {"results": [
                {"name": "code", "type": "TEXT", "cid": 0},
                {"name": "name", "type": "TEXT", "cid": 1},
            ]}
        ]))
        return 0
    metrics = [
        ("languages", 62),
        ("languoids", 27177),
        ("language_locations", 45),
        ("expressions", 1308),
        ("expression_edges", 1058),
        ("users", 0),
        ("email_verification_tokens", 0),
        ("handbooks", 0),
        ("handbook_sections", 0),
        ("handbook_section_items", 0),
        ("votes", 0),
        ("ui_locales", 4),
        ("ui_messages", 312),
        ("managed_ui_messages", 312),
        ("managed_ui_edges", 1058),
        ("orphan_languages", 0),
        ("orphan_ui_messages", 0),
        ("orphan_expression_edges", 0),
    ]
    print(json.dumps([{"results": [{"metric": metric, "count": count}]} for metric, count in metrics]))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
